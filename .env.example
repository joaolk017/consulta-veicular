# Consulta Veicular 360 — exemplo de configuração
# Nunca coloque chaves reais neste arquivo.

NODE_ENV=production
PORT=3000

# Banco PostgreSQL
DATABASE_URL=

# APIs veiculares
FALCON_TOKEN=
FONTEDATA_API_KEY=

# Woovi / OpenPix
OPENPIX_APP_ID=
# WOOVI_APP_ID=  # alias aceito pelo backend
OPENPIX_API_URL=https://api.woovi.com/api/v1
OPENPIX_WEBHOOK_SECRET=

# Assinatura interna de pagamentos/créditos
PAYMENT_SIGNING_SECRET=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Painel administrativo
ADMIN_FUNNEL_SECRET=

# API Full — manter desligada até homologação com saldo e autorização
APIFULL_ENABLED=false
APIFULL_TOKEN=
# Confirmar URL base e esquema de autenticação na documentação da conta
APIFULL_BASE_URL=
# Nenhuma chamada à API Full é feita enquanto APIFULL_ENABLED=false

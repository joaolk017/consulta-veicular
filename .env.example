# Consulta Veicular 360 — exemplo de configuração
# Nunca coloque chaves reais neste arquivo.

NODE_ENV=production
PORT=3000
DATABASE_URL=
FALCON_TOKEN=
FONTEDATA_API_KEY=
OPENPIX_APP_ID=
OPENPIX_API_URL=https://api.woovi.com/api/v1
OPENPIX_WEBHOOK_SECRET=
PAYMENT_SIGNING_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_FUNNEL_SECRET=

# API Full: formato de autenticação confirmado na documentação pública (Bearer).
# Sem saldo, manter desligada. Não efetuar consultas pagas nesta etapa.
APIFULL_ENABLED=false
APIFULL_TOKEN=
APIFULL_BASE_URL=https://api.apifull.com.br

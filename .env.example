# Consulta Veicular 360 — exemplo de configuração
# Nunca coloque chaves reais neste arquivo.

NODE_ENV=production
PORT=3000

# Banco PostgreSQL
DATABASE_URL=

# API veicular
FALCON_TOKEN=

# Woovi / OpenPix
OPENPIX_APP_ID=
# WOOVI_APP_ID=  # alias aceito pelo backend
OPENPIX_API_URL=https://api.woovi.com/api/v1
OPENPIX_WEBHOOK_SECRET=

# Assinatura interna de pagamentos/créditos
PAYMENT_SIGNING_SECRET=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Painel administrativo
ADMIN_FUNNEL_SECRET=
